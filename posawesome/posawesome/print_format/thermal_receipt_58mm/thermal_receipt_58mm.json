 "absolute_value": 0,
 "align_labels_right": 0,
 "creation": "2025-10-28 15:39:00.097123",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "POS Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 9,
 "html": "<style>\n    @media print {\n        @page {\n            size: 58mm auto;\n            margin: 2mm;\n        }\n    }\n    \n    * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n    }\n    \n    body {\n        font-family: 'Courier New', monospace;\n        font-size: 9pt;\n        width: 58mm;\n        margin: 0 auto;\n        padding: 2mm 4mm;\n        color: #000;\n    }\n    \n    .receipt {\n        width: 100%;\n        padding: 0 4mm 0 0;\n    }\n    \n    .text-center {\n        text-align: center;\n    }\n    \n    .text-right {\n        text-align: right;\n    }\n    \n    .bold {\n        font-weight: bold;\n    }\n    \n    .header {\n        text-align: center;\n        margin-bottom: 3mm;\n        padding-bottom: 2mm;\n        border-bottom: 1px dashed #000;\n    }\n    \n    .company-name {\n        font-size: 12pt;\n        font-weight: bold;\n        margin-bottom: 1mm;\n    }\n    \n    .company-info {\n        font-size: 8pt;\n        line-height: 1.3;\n    }\n    \n    .separator {\n        border-top: 1px dashed #000;\n        margin: 2mm 0;\n    }\n    \n    .separator-double {\n        border-top: 1px solid #000;\n        margin: 2mm 0;\n    }\n    \n    .info-row {\n        display: flex;\n        justify-content: space-between;\n        font-size: 8pt;\n        margin: 1mm 0;\n    }\n    \n    .items-table {\n        width: 100%;\n        margin: 2mm 0;\n        font-size: 8pt;\n    }\n    \n    .item-row {\n        margin: 1.5mm 0;\n    }\n    \n    .item-name {\n        font-weight: bold;\n        margin-bottom: 0.5mm;\n    }\n    \n    .item-details {\n        display: flex;\n        justify-content: space-between;\n        font-size: 8pt;\n    }\n    \n    .totals {\n        margin-top: 2mm;\n        padding-top: 2mm;\n        border-top: 1px solid #000;\n    }\n    \n    .total-row {\n        display: flex;\n        justify-content: space-between;\n        margin: 1mm 0;\n    }\n    \n    .grand-total {\n        font-size: 11pt;\n        font-weight: bold;\n        padding: 2mm 0;\n        border-top: 1px solid #000;\n        border-bottom: 1px solid #000;\n        margin: 2mm 0;\n    }\n    \n    .payment-info {\n        margin: 2mm 0;\n        font-size: 8pt;\n    }\n    \n    .footer {\n        text-align: center;\n        margin-top: 3mm;\n        padding-top: 2mm;\n        border-top: 1px dashed #000;\n        font-size: 8pt;\n    }\n    \n    .barcode {\n        text-align: center;\n        margin: 3mm 0;\n        font-size: 10pt;\n        font-family: 'Courier New', monospace;\n    }\n</style>\n\n<div class=\"receipt\">\n    <!-- Header -->\n    <div class=\"header\">\n        <div class=\"company-name\">{{ doc.company }}</div>\n        {% if doc.company_address_display %}\n        <div class=\"company-info\">{{ doc.company_address_display|replace(\"\\n\", \"<br>\")|safe }}</div>\n        {% endif %}\n        {% if frappe.db.get_value(\"Company\", doc.company, \"phone_no\") %}\n        <div class=\"company-info\">Tel: {{ frappe.db.get_value(\"Company\", doc.company, \"phone_no\") }}</div>\n        {% endif %}\n    </div>\n    \n    <!-- Invoice Info -->\n    <!-- <div class=\"info-row\">\n        <span>No Invoice:</span>\n        <span class=\"bold\">{{ doc.name }}</span>\n    </div> -->\n    <div class=\"info-row\">\n        <span>Tanggal:</span>\n        <span>{{ frappe.format_date(doc.posting_date, \"dd/MM/yyyy\") }} {{ doc.posting_time }}</span>\n    </div>\n    {% if doc.pos_profile %}\n    <div class=\"info-row\">\n        <span>Kasir:</span>\n        <span>{{ doc.owner.split(\"@\")[0] }}</span>\n    </div>\n    {% endif %}\n    {% if doc.customer and doc.customer != \"Guest\" %}\n    <div class=\"info-row\">\n        <span>Customer:</span>\n        <span>{{ doc.customer_name or doc.customer }}</span>\n    </div>\n    {% endif %}\n    \n    <div class=\"separator\"></div>\n    \n    <!-- Items -->\n    <div class=\"items-table\">\n        {% for item in doc.items %}\n        <div class=\"item-row\">\n            <div class=\"item-name\">{{ item.item_name or item.item_code }}</div>\n            <div class=\"item-details\">\n                <span>{{ \"%.0f\"|format(item.qty) }} x {{ frappe.format_value(item.rate, {\"fieldtype\": \"Currency\"}) }}</span>\n                <span class=\"bold\">{{ frappe.format_value(item.amount, {\"fieldtype\": \"Currency\"}) }}</span>\n            </div>\n            {% if item.discount_percentage and item.discount_percentage > 0 %}\n            <div class=\"item-details\" style=\"font-size: 7pt; color: #666;\">\n                <span>Diskon {{ \"%.0f\"|format(item.discount_percentage) }}%</span>\n                <span>-{{ frappe.format_value(item.discount_amount, {\"fieldtype\": \"Currency\"}) }}</span>\n            </div>\n            {% endif %}\n        </div>\n        {% endfor %}\n    </div>\n    \n    <div class=\"separator\"></div>\n    \n    <!-- Totals -->\n    <div class=\"totals\">\n        {% if doc.discount_amount and doc.discount_amount > 0 %}\n        <div class=\"total-row\">\n            <span>Diskon:</span>\n            <span>-{{ frappe.format_value(doc.discount_amount, {\"fieldtype\": \"Currency\"}) }}</span>\n        </div>\n        {% endif %}\n        \n        {% if doc.total_taxes_and_charges and doc.total_taxes_and_charges > 0 %}\n        <div class=\"total-row\">\n            <span>Pajak:</span>\n            <span>{{ frappe.format_value(doc.total_taxes_and_charges, {\"fieldtype\": \"Currency\"}) }}</span>\n        </div>\n        {% endif %}\n        \n        <div class=\"separator-double\"></div>\n        \n        <div class=\"total-row grand-total\">\n            <span>TOTAL:</span>\n            <span>{{ frappe.format_value(doc.rounded_total or doc.grand_total, {\"fieldtype\": \"Currency\"}) }}</span>\n        </div>\n    </div>\n    \n    <!-- Payment Method -->\n    {% if doc.payments %}\n    <div class=\"payment-info\">\n        {% for payment in doc.payments %}\n        {% if payment.amount > 0 %}\n        <div class=\"total-row\">\n            <span>{{ payment.mode_of_payment }}:</span>\n            <span>{{ frappe.format_value(payment.amount, {\"fieldtype\": \"Currency\"}) }}</span>\n        </div>\n        {% endif %}\n        {% endfor %}\n        \n        {% set total_paid = doc.payments|sum(attribute='amount') %}\n        {% set change = total_paid - (doc.rounded_total or doc.grand_total) %}\n        \n        {% if change > 0 %}\n        <div class=\"separator\"></div>\n        <div class=\"total-row\">\n            <span>Bayar:</span>\n            <span>{{ frappe.format_value(total_paid, {\"fieldtype\": \"Currency\"}) }}</span>\n        </div>\n        <div class=\"total-row bold\">\n            <span>Kembali:</span>\n            <span>{{ frappe.format_value(change, {\"fieldtype\": \"Currency\"}) }}</span>\n        </div>\n        {% endif %}\n    </div>\n    {% endif %}\n    \n    <!-- Barcode / Invoice Number -->\n    <div class=\"barcode\">\n        {{ doc.name }}\n    </div>\n    \n    <!-- Footer -->\n    <div class=\"footer\">\n        <div>*** TERIMA KASIH ***</div>\n        <div>SELAMAT BERBELANJA KEMBALI</div>\n        {% if doc.posa_notes %}\n        <div style=\"margin-top: 2mm;\">{{ doc.posa_notes }}</div>\n        {% endif %}\n    </div>\n</div>\n\n<script>\n    // Auto print when loaded\n    window.onload = function() {\n        window.print();\n    }\n</script>\n",
